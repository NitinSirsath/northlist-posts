# Copy to .env for local runs. Never commit .env.
DATABASE_URL=postgresql://user@localhost:5432/northlist_posts_dev?schema=public
PUBLIC_URL=http://localhost:5590
PORT=3590
# Who may sign in (comma list).
OWNER_EMAIL=you@example.com
# Local testing only (refused in production): sign in without Google, fake X and LinkedIn.
DEV_LOGIN=1
FAKE_SOCIAL=1
# Production settings (Render):
# NODE_ENV=production
# ENCRYPTION_KEY=   32 random bytes, base64 (openssl rand -base64 32)
# GOOGLE_CLIENT_ID= / GOOGLE_CLIENT_SECRET=
# X_CLIENT_ID= / X_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID= / LINKEDIN_CLIENT_SECRET= / LINKEDIN_API_VERSION=202611
# VAPID_PUBLIC_KEY= / VAPID_PRIVATE_KEY= / VAPID_SUBJECT=mailto:you@example.com
# MCP_ALLOWED_HOSTS=   extra host names for /mcp, comma list
# KIT_URL=https://github.com/NitinSirsath/northlist-posts-kit
