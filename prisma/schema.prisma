// NorthList Posts: your AI writes post ideas and sends them over MCP; you pick, edit and post.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String
  createdAt         DateTime           @default(now())
  /// The first-run steps (owner, 22 Nov 2026): the step reached, and when they were finished or skipped.
  onboardingStep    Int                @default(0)
  onboardedAt       DateTime?
  sessions          Session[]
  spaces            Space[]
  ideas             Idea[]
  posts             Post[]
  connections       SocialConnection[]
  integrationTokens IntegrationToken[]
  pushSubscriptions PushSubscription[]
  shortLinks        ShortLink[]
}

/// A signed-in browser. Only the SHA-256 of the cookie value is stored.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Goal {
  PROMOTE
  NETWORK
  JOB
}

enum Tone {
  PLAIN
  FRIENDLY
  BOLD
}

/// A space (owner, 22 Nov 2026): one goal with its own links, interests, voice, rhythm and its own X and
/// LinkedIn accounts, e.g. "NorthList" and "Personal". The AI reads every space (get_profile) and sends
/// each draft to one space.
model Space {
  id            String             @id @default(cuid())
  userId        String
  name          String
  goal          Goal               @default(PROMOTE)
  productName   String             @default("")
  productUrl    String             @default("")
  productLine   String             @default("")
  interests     String[]           @default([])
  postsPerDay   Int                @default(3)
  repliesPerDay Int                @default(0)
  useX          Boolean            @default(true)
  useLinkedIn   Boolean            @default(true)
  tone          Tone               @default(PLAIN)
  styleSamples  String[]           @default([])
  /// When the drafts should be waiting, "HH:MM" in the user's own time.
  readyAt       String             @default("08:00")
  weekends      Boolean            @default(false)
  position      Int                @default(0)
  /// "you" or the name of the AI token that last saved it.
  updatedBy     String             @default("you")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  links         SourceLink[]
  connections   SocialConnection[]
  ideas         Idea[]

  @@index([userId, position])
}

enum LinkKind {
  WEBSITE
  GITHUB_REPO
  GITHUB_PROFILE
  PAGE
}

/// A link the AI reads for a space: a product site, a GitHub repo or profile, a changelog, any page.
/// We read the title and one line when it is added. Private repos are read by the user's own AI.
model SourceLink {
  id          String   @id @default(cuid())
  spaceId     String
  url         String
  kind        LinkKind
  title       String   @default("")
  description String   @default("")
  isPrivate   Boolean  @default(false)
  /// False when the page could not be read when it was added (it is kept; the AI may still reach it).
  readOk      Boolean  @default(true)
  createdAt   DateTime @default(now())
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, url])
}

enum IdeaKind {
  SHIPPED
  NEWS
  OWN
  REPLY
}

enum IdeaStatus {
  NEW
  SKIPPED
}

/// One post idea from the AI, with an X text and/or a LinkedIn text.
model Idea {
  id              String      @id @default(cuid())
  userId          String
  spaceId         String
  kind            IdeaKind
  title           String
  why             String      @default("")
  sourceUrl       String?
  sourceName      String?
  mentionsProduct Boolean     @default(false)
  replyToUrl      String?
  replyToAuthor   String?
  replyToText     String?
  xText           String?
  linkedinText    String?
  take            String      @default("")
  status          IdeaStatus  @default(NEW)
  /// When "Copy and open" was last used on a reply draft.
  copiedAt        DateTime?
  /// Name of the AI token that sent it.
  fromAi          String
  /// Same idea sent twice is kept once.
  dedupeKey       String
  createdAt       DateTime    @default(now())
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  space           Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  posts           Post[]
  shortLinks      ShortLink[]

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([spaceId, createdAt])
}

enum Channel {
  X
  LINKEDIN
}

enum PostStatus {
  WAITING
  SENDING
  POSTED
  FAILED
  CANCELLED
}

/// One post to one channel. It waits 10 seconds (Undo) before it is sent.
model Post {
  id        String     @id @default(cuid())
  userId    String
  ideaId    String
  channel   Channel
  text      String
  status    PostStatus @default(WAITING)
  sendAt    DateTime
  postedAt  DateTime?
  url       String?
  error     String?
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea      Idea       @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([status, sendAt])
  @@index([userId, createdAt])
}

/// A connected X or LinkedIn account, in one space (one X and one LinkedIn per space). Tokens are
/// encrypted (AES-256-GCM).
model SocialConnection {
  id              String    @id @default(cuid())
  userId          String
  spaceId         String
  channel         Channel
  accountId       String
  accountName     String
  accessTokenEnc  String
  refreshTokenEnc String?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  space           Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, channel])
  /// The same account is in one space only.
  @@unique([userId, channel, accountId])
}

/// MCP tokens for the user's AI. Only the SHA-256 hash and a display prefix are stored.
model IntegrationToken {
  id            String    @id @default(cuid())
  userId        String
  name          String
  tokenHash     String    @unique
  displayPrefix String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Our short link for a product link in one channel's text; counts clicks.
model ShortLink {
  code      String   @id
  userId    String
  ideaId    String
  channel   Channel
  targetUrl String
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
}

/// Short-lived OAuth state for connecting X or LinkedIn (PKCE verifier included).
model OAuthState {
  state     String   @id
  userId    String?
  purpose   String
  verifier  String
  createdAt DateTime @default(now())
  expiresAt DateTime
}
